# ==========================================
# MEDIKTO BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=production

# Amazon DocumentDB (or MongoDB) Connection URI
# Example DocumentDB URI format:
# MONGO_URI=mongodb://<docdb_user>:<docdb_password>@<docdb_cluster_endpoint>:27017/medikto?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_URI=mongodb://localhost:27017/medikto

# Path to DocumentDB Global CA Certificate Bundle (inside Docker container: /app/certs/global-bundle.pem)
DOCDB_CA_PATH=/app/certs/global-bundle.pem

# AWS S3 Storage Configuration
# IMPORTANT: Authentication is handled automatically by the EC2 IAM Role (MediktoEC2S3Role).
# DO NOT add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=medikto-s3-bucket

# JWT Token Secret
JWT_SECRET=your_secure_jwt_secret_key_here

# Fast2SMS Provider Config (Optional fallback)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Twilio SMS Provider Config
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Firebase Admin SDK (for Push Notifications / FCM)
# Place your firebase-service-account.json in Backend/certs/ or specify the path:
FIREBASE_SERVICE_ACCOUNT_PATH=/app/certs/firebase-service-account.json

# Super Admin & Google OAuth
SUPERADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK=https://api-prd.medikto.com/api/superadmin/google/callback

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

